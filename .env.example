# Token API Pennylane (Paramètres > API dans Pennylane)
PENNYLANE_API_TOKEN=

# Optionnel — ne pas modifier sauf changement de version d'API
PENNYLANE_API_BASE_URL=https://app.pennylane.com/api/external/v2

# Secret partagé protégeant l'endpoint MCP. Obligatoire : sans lui, le serveur
# répond 401 à toutes les requêtes. Générer avec `openssl rand -hex 32`.
MCP_AUTH_TOKEN=
