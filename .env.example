# Token API Pennylane (Paramètres > API dans Pennylane)
PENNYLANE_API_TOKEN=

# Optionnel — ne pas modifier sauf changement de version d'API
PENNYLANE_API_BASE_URL=https://app.pennylane.com/api/external/v2

# Secret partagé protégeant l'endpoint MCP. Obligatoire : sans lui, le serveur
# répond 401 à toutes les requêtes. Générer avec `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# --- OAuth 2.1 (Claude, ChatGPT). Actif seulement si les cinq variables
# suivantes sont renseignées ; sinon seul MCP_AUTH_TOKEN est accepté.

# URL publique de l'endpoint MCP, telle que saisie dans le client.
MCP_PUBLIC_URL=

# Clé de signature des jetons d'accès. Générer avec `openssl rand -hex 32`.
OAUTH_SIGNING_KEY=

# Mot de passe du propriétaire, demandé sur la page de consentement.
# 16 caractères au moins ; à générer dans un gestionnaire de mots de passe.
OAUTH_OWNER_PASSWORD=

# Base Upstash Redis (Marketplace Vercel) : codes et refresh tokens, stockés
# par empreinte uniquement.
KV_REST_API_URL=
KV_REST_API_TOKEN=
